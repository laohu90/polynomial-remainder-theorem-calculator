{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "routes": [
    { "src": "/sitemap.xml", "headers": { "content-type": "application/xml; charset=utf-8" } },
    { "src": "/robots.txt", "headers": { "content-type": "text/plain; charset=utf-8" } },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
